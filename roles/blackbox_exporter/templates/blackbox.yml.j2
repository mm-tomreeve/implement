# {{ ansible_managed }}
modules:
  # The Mattermost health endpoint, as a user's browser would reach it.
  http_mattermost:
    prober: http
    timeout: 10s
    http:
      method: GET
      valid_status_codes: [200]
      preferred_ip_protocol: ip4
      fail_if_body_not_matches_regexp: ['"status":"OK"']
      tls_config:
        insecure_skip_verify: {{ (not (monitoring_site_tls_verify | bool)) | to_json }}
{% if monitoring_site_ca_file | length > 0 %}
        ca_file: {{ blackbox_exporter_conf_dir }}/site-ca.pem
{% endif %}
  # Can clients open a TCP connection to the Calls media port?
  tcp_connect:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
