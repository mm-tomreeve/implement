# {{ ansible_managed }}
# Mattermost reverse proxy for {{ nginx_server_name }}.
upstream mattermost_backend {
{% for upstream in mmd_nginx_upstreams %}
    server {{ upstream }};
{% endfor %}
    keepalive 64;
}

proxy_cache_path {{ nginx_cache_dir }} levels=1:2 keys_zone=mattermost_cache:10m max_size=3g inactive=120m use_temp_path=off;

{% macro proxy_common() %}
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frame-Options SAMEORIGIN;
        proxy_buffers 256 16k;
        proxy_buffer_size 16k;
        proxy_http_version 1.1;
{% endmacro %}
{% macro locations() %}
    location ~ /api/v[0-9]+/(users/)?websocket$ {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 50M;
{{ proxy_common() }}
        client_body_timeout 60s;
        send_timeout 300s;
        lingering_timeout 5s;
        proxy_connect_timeout 90s;
        proxy_send_timeout 300s;
        proxy_read_timeout 90s;
        proxy_pass http://mattermost_backend;
    }

    location / {
        client_max_body_size {{ nginx_client_max_body_size }};
        proxy_set_header Connection "";
{{ proxy_common() }}
        proxy_read_timeout 600s;
        proxy_cache mattermost_cache;
        proxy_cache_revalidate on;
        proxy_cache_min_uses 2;
        proxy_cache_use_stale timeout;
        proxy_cache_lock on;
        proxy_pass http://mattermost_backend;
    }
{% endmacro %}
{% if 'nginx_exporter' in mmd_selected %}
# stub_status for nginx_exporter, on loopback only.
server {
    listen 127.0.0.1:{{ nginx_stub_status_port }};
    server_name localhost;
    access_log off;
    location = /stub_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
    }
}

{% endif %}
{% if tls_mode == 'provided' %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{% if _nginx_http2_on %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ nginx_server_name }};

    ssl_certificate {{ tls_install_dir }}/mattermost.crt;
    ssl_certificate_key {{ tls_install_dir }}/mattermost.key;
    ssl_protocols {{ nginx_ssl_protocols }};
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MattermostTLS:10m;
    ssl_session_tickets off;
{% if nginx_hsts | bool %}
    add_header Strict-Transport-Security "max-age=63072000" always;
{% endif %}

{{ locations() }}
}
{% else %}
# TLS is not configured yet (tls_mode: later). Mattermost is served over plain
# HTTP. Re-run install.sh with tls_mode: provided once the certificate is ready.
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};

{{ locations() }}
}
{% endif %}
