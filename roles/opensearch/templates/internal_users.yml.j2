# {{ ansible_managed }}
# Only these users exist. The OpenSearch demo users are removed on purpose.
_meta:
  type: "internalusers"
  config_version: 2

admin:
  hash: "{{ _os_hash_store.admin.hash }}"
  reserved: true
  backend_roles:
    - "admin"
  description: "Cluster administrator (mattermost-parthenon)"

# No backend_roles: this account is given the {{ opensearch_mattermost_role_name }} role
# instead, which is created through the security API in tasks/authz.yml. The
# admin backend role would make it a cluster administrator, and its password is
# on every Mattermost app server.
{{ mattermost_opensearch_username }}:
  hash: "{{ _os_hash_store[mattermost_opensearch_username].hash }}"
  reserved: false
  description: "Mattermost server connection (mattermost-parthenon)"
