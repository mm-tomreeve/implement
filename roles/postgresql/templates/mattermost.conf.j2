# {{ ansible_managed }}
# Mattermost tuning. Sized from {{ ansible_facts['memtotal_mb'] }} MB RAM on {{ ansible_facts['fqdn'] }}.
listen_addresses = '{{ mmd_postgresql_listen }}'
port = {{ postgresql_port }}
# {{ mmd_postgresql_app_servers }} app server(s) x {{ mattermost_db_max_open_conns }} connections{{ " + " ~ postgresql_spare_connections ~ " spare" if postgresql_max_connections == "auto" else " (set by hand)" }}
max_connections = {{ mmd_postgresql_max_connections }}
password_encryption = scram-sha-256

shared_buffers = {{ (ansible_facts['memtotal_mb'] * (postgresql_shared_buffers_pct | int) / 100) | int }}MB
effective_cache_size = {{ (ansible_facts['memtotal_mb'] * (postgresql_effective_cache_pct | int) / 100) | int }}MB
work_mem = {{ postgresql_work_mem }}
maintenance_work_mem = {{ [[(ansible_facts['memtotal_mb'] * 5 / 100) | int, 64] | max, 1024] | min }}MB
random_page_cost = {{ postgresql_random_page_cost }}
idle_in_transaction_session_timeout = 60s
tcp_keepalives_idle = 5
tcp_keepalives_interval = 1
tcp_keepalives_count = 5

{% if mmd_postgresql_ssl | bool %}
ssl = on
ssl_cert_file = 'server.crt'
ssl_key_file = 'server.key'
ssl_min_protocol_version = 'TLSv1.2'
{% else %}
ssl = off
{% endif %}
