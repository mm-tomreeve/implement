# {{ ansible_managed }}
[Unit]
Description=Mattermost
After=network.target{{ ' postgresql.service' if mmd_db_local else '' }}{{ ' opensearch.service' if 'opensearch' in mmd_selected else '' }}
{% if mmd_db_local %}
BindsTo=postgresql.service
{% endif %}

[Service]
Type=notify
ExecStart={{ mattermost_dir }}/bin/mattermost
TimeoutStartSec=3600
KillMode=mixed
Restart=always
RestartSec=10
WorkingDirectory={{ mattermost_dir }}
User={{ mattermost_user }}
Group={{ mattermost_group }}
LimitNOFILE=49152
# Config lives in the database. The connection string that points there holds the
# database password, so it sits in a root-only file rather than in this unit.
EnvironmentFile={{ mattermost_env_file }}
# Logs live outside the install directory too, so tell Mattermost where the log root is.
Environment=MM_LOG_PATH={{ mattermost_log_dir }}
{% if mmd_calls_recording | bool and mmd_recorder_site_url | length > 0 %}
# The recorder and transcriber run in containers on the job server and connect
# back to Mattermost. They get this address instead of the public site URL, which
# they may not be able to resolve or route to.
Environment=MM_CALLS_RECORDER_SITE_URL={{ mmd_recorder_site_url }}
Environment=MM_CALLS_TRANSCRIBER_SITE_URL={{ mmd_recorder_site_url }}
{% endif %}

[Install]
WantedBy=multi-user.target
