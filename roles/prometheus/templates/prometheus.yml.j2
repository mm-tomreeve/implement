# {{ ansible_managed }}
# Built from the estate: every server and what it runs. Each target carries the
# server's name as its instance label, so alerts and dashboards read naturally.
{% set jobs = [
     {'job': 'node',       'component': None,         'port': node_exporter_port,       'path': '/metrics'},
     {'job': 'postgres',   'component': 'postgresql', 'port': postgres_exporter_port,   'path': '/metrics'},
     {'job': 'nginx',      'component': 'nginx',      'port': nginx_exporter_port,      'path': '/metrics'},
     {'job': 'opensearch', 'component': 'opensearch', 'port': opensearch_exporter_port, 'path': '/metrics'},
     {'job': 'mattermost', 'component': 'mattermost', 'port': mattermost_metrics_port,  'path': '/metrics'},
     {'job': 'rtcd',       'component': 'rtcd',       'port': rtcd_api_port,            'path': '/metrics'},
     {'job': 'prometheus', 'component': 'prometheus', 'port': prometheus_port,          'path': '/metrics'},
     {'job': 'grafana',    'component': 'grafana',    'port': grafana_port,             'path': '/metrics'},
     {'job': 'loki',       'component': 'loki',       'port': loki_port,                'path': '/metrics'},
   ] %}
{% set estate = mmd_estate | default([]) %}
{% set extra_names = prometheus_scrape_targets | map(attribute='job') | list %}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    deployment: {{ deploy_name }}

scrape_configs:
{% for j in jobs %}
{%   set servers = estate if j.component is none else (estate | selectattr('components', 'contains', j.component) | list) %}
{%   set extra = prometheus_scrape_targets | selectattr('job', 'equalto', j.job) | map(attribute='targets') | flatten | list %}
{%   if servers or extra %}
  - job_name: {{ j.job }}
    metrics_path: {{ j.path }}
    static_configs:
{%     for s in servers %}
      - targets: ["{{ s.address }}:{{ j.port }}"]
        labels: {instance: "{{ s.name }}"}
{%     endfor %}
{%     if extra %}
      - targets: {{ extra | to_json }}
{%     endif %}

{%   endif %}
{% endfor %}
{% if 'loki' in mmd_selected and estate %}
  # The log shipper on every server. With Loki here, every server is expected to ship.
  # Its own alerts (log-ship-failing, log-host-silent) cover it, not target-down.
  - job_name: otelcol
    metrics_path: /metrics
    static_configs:
{%   for s in estate %}
      - targets: ["{{ s.address }}:{{ otel_collector_metrics_port }}"]
        labels: {instance: "{{ s.name }}"}
{%   endfor %}

{% endif %}
{% if 'blackbox_exporter' in mmd_selected and monitoring_site_url | length > 0 %}
  # The site as users reach it, checked from this server.
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_mattermost]
    static_configs:
      - targets: ["{{ monitoring_site_url | regex_replace('/+$', '') }}/api/v4/system/ping"]
        labels: {instance: "{{ monitoring_site_url | urlsplit('hostname') }}"}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: 127.0.0.1:{{ blackbox_exporter_port }}

{% endif %}
{% set calls = estate | selectattr('components', 'contains', 'rtcd') | list %}
{% if 'blackbox_exporter' in mmd_selected and calls %}
  # Can clients reach the Calls media port?
  - job_name: blackbox_tcp_calls
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
{%   for s in calls %}
      - targets: ["{{ s.address }}:{{ rtcd_rtc_port }}"]
        labels: {instance: "{{ s.name }}"}
{%   endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: 127.0.0.1:{{ blackbox_exporter_port }}

{% endif %}
{% for job in prometheus_scrape_targets if job.job not in (jobs | map(attribute='job') | list) %}
  - job_name: {{ job.job | to_json }}
    metrics_path: {{ job.metrics_path | default('/metrics') | to_json }}
    scheme: {{ job.scheme | default('http') }}
    static_configs:
      - targets: {{ job.targets | to_json }}

{% endfor %}
